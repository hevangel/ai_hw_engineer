[tasks]
bmc
cover
[options]
bmc: mode bmc
bmc: depth 32
cover: mode cover
cover: depth 32
[engines]
bmc: abc bmc3
cover: smtbmc yices
[script]
read -formal -sv model30_fixed_disk.sv
chparam -set CYLINDERS 4 -set HEADS 2 -set SECTORS 3 -set COMMAND_CYCLES 2 -set SECTOR_CYCLES 4 model30_fixed_disk
prep -top model30_fixed_disk
[files]
../src/model30_fixed_disk.sv
