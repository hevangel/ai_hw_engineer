; Front-panel demonstration: plot a diagonal sweep of 64 points through the
; Type 30 point-plot IOT, then type "pdp-1" on the console typewriter and halt.
        law 0
        dac x
        dac y
loop:   lac x
        lio y
        iot dpy
        lac x
        add step
        dac x
        lac y
        add step
        dac y
        sas limit
        jmp loop
; typewriter message: the device takes the character from the IO register
        lio m1
        iot tyo
        lio m2
        iot tyo
        lio m3
        iot tyo
        lio m4
        iot tyo
        lio m5
        iot tyo
        hlt

.org 0o100
x:      .word 0
y:      .word 0
step:   .word 4000
limit:  .word 400000
m1:     .word 47          ; p
m2:     .word 64          ; d
m3:     .word 47          ; p
m4:     .word 1           ; 1
m5:     .word 77          ; carriage return
