[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 20

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
bmc: read -formal -D FORMAL ../src/intel_8255.sv
bmc: read -formal intel_8255_props.sv
prove: read -formal -D FORMAL ../src/intel_8255.sv
prove: read -formal intel_8255_props.sv
cover: read -formal -D FORMAL -D FORMAL_COVER ../src/intel_8255.sv
cover: read -formal intel_8255_cover.sv
prep -top intel_8255

[files]
../src/intel_8255.sv
intel_8255_props.sv
intel_8255_cover.sv
