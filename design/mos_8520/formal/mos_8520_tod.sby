[tasks]
bmc
prove
cover
[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 40
[engines]
bmc: abc bmc3
prove: smtbmc yices
cover: smtbmc --syn --nopresat yices
[script]
read -formal -D FORMAL -I . mos_8520_tod.sv
prep -top mos_8520_tod
chtype -map $shiftx $shift
setundef -anyseq
[files]
../src/mos_8520_tod.sv
mos_8520_tod_props.sv
