[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 30

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat --unroll z3

[script]
bmc: read -formal -D FORMAL ../src/intel_8259.sv
bmc: read -formal intel_8259_props.sv
prove: read -formal -D FORMAL ../src/intel_8259.sv
prove: read -formal intel_8259_props.sv
cover: read -formal -D FORMAL -D FORMAL_COVER ../src/intel_8259.sv
cover: read -formal intel_8259_cover.sv
prep -top intel_8259

[files]
../src/intel_8259.sv
intel_8259_props.sv
intel_8259_cover.sv
