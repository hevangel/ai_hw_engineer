[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 8

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat --unroll z3

[script]
bmc: read -formal -D FORMAL ../src/intel_8279.sv
bmc: read -formal intel_8279_props.sv
prove: read -formal -D FORMAL ../src/intel_8279.sv
prove: read -formal intel_8279_props.sv
cover: read -formal -D FORMAL -D FORMAL_COVER ../src/intel_8279.sv
cover: read -formal intel_8279_cover.sv
cover: chparam -set SCAN_DIV 1 intel_8279
prep -top intel_8279

[files]
../src/intel_8279.sv
intel_8279_props.sv
intel_8279_cover.sv
