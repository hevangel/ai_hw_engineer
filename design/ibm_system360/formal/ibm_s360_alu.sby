[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 1
bmc: multiclock off
cover: mode cover
cover: depth 1
cover: multiclock off

[engines]
bmc: smtbmc z3
cover: smtbmc z3

[script]
