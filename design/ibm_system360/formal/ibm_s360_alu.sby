bmc: prep -top ibm_s360_alu_props
cover: read -formal -D FORMAL ../src/ibm_s360_alu.sv ibm_s360_alu_props.sv
cover: prep -top ibm_s360_alu_props

[files]
../src/ibm_s360_defs.svh
../src/ibm_s360_alu.sv
ibm_s360_alu_props.sv
