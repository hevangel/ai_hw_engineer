[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 32
prove: mode prove
cover: mode cover
cover: depth 36

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
bmc: read -formal -D FORMAL intel_8237.sv
prove: read -formal -D FORMAL intel_8237.sv
cover: read -formal -D FORMAL -D FORMAL_COVER intel_8237.sv
prep -top intel_8237

[files]
../src/intel_8237.sv
intel_8237_props.sv
intel_8237_cover_setup.sv
