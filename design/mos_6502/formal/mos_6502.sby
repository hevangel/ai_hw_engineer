[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC mos_6502.sv
prove: read -formal -D FORMAL mos_6502.sv
cover: read -formal -D FORMAL -D FORMAL_COVER mos_6502.sv
async2sync
prep -top mos_6502

[files]
../src/mos_6502.sv
mos_6502_props.sv
mos_6502_cover_setup.sv
