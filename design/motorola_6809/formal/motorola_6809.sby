[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC motorola_6809.sv
prove: read -formal -D FORMAL motorola_6809.sv
cover: read -formal -D FORMAL -D FORMAL_COVER motorola_6809.sv
async2sync
prep -top motorola_6809

[files]
../src/motorola_6809.sv
motorola_6809_props.sv
motorola_6809_cover_setup.sv
