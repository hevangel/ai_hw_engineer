                      (nterrupt_test.asm):00001         ; ============================================================
                      (nterrupt_test.asm):00002         ;  MC6809 interrupt test
                      (nterrupt_test.asm):00003         ;  GPL-3.0-or-later, see license.txt
                      (nterrupt_test.asm):00004         ; ============================================================
                      (nterrupt_test.asm):00005         ;
                      (nterrupt_test.asm):00006         ; Tests IRQ, FIRQ and NMI: masking, priority, the stack frames and the CC
                      (nterrupt_test.asm):00007         ; bits each one sets, level (IRQ/FIRQ) versus edge (NMI) sensing, NMI being
                      (nterrupt_test.asm):00008         ; disarmed until S is first loaded, CWAI and SYNC.
                      (nterrupt_test.asm):00009         ;
                      (nterrupt_test.asm):00010         ; Needs the test device (see common.inc): the program raises and drops the
                      (nterrupt_test.asm):00011         ; interrupt lines itself through DEV_LINES, or schedules a change a number
                      (nterrupt_test.asm):00012         ; of cycles ahead with DEV_DLINES / DEV_DELAY so it can happen while the CPU
                      (nterrupt_test.asm):00013         ; waits in CWAI or SYNC.
                      (nterrupt_test.asm):00014         ;
                      (nterrupt_test.asm):00015         ; A CPU samples its interrupt inputs a cycle or so before an instruction
                      (nterrupt_test.asm):00016         ; ends, so an interrupt raised by a store can be taken after the following
                      (nterrupt_test.asm):00017         ; instruction rather than straight away. The tests leave a few NOPs for it.
                      (nterrupt_test.asm):00018         ;
                      (nterrupt_test.asm):00019         ; Runs unchanged on an HD6309 in emulation mode.
                      (nterrupt_test.asm):00020         ;
                      (nterrupt_test.asm):00021         ; Test numbers (TEST_CASE at $0100):
                      (nterrupt_test.asm):00022         ;   $01 NMI ignored until the first LDS     $09 NMI is edge triggered
                      (nterrupt_test.asm):00023         ;   $02 IRQ: frame, CC, vector              $0A NMI beats FIRQ beats IRQ
                      (nterrupt_test.asm):00024         ;   $03 IRQ masked by I                     $0B registers survive an IRQ
                      (nterrupt_test.asm):00025         ;   $04 IRQ is level triggered              $0C stacked PC is the next instruction
                      (nterrupt_test.asm):00026         ;   $05 FIRQ: frame, CC, vector             $0D CWAI with IRQ and with FIRQ
                      (nterrupt_test.asm):00027         ;   $06 FIRQ masked by F, not by I          $0E SYNC, interrupt masked
                      (nterrupt_test.asm):00028         ;   $07 IRQ nested in a FIRQ handler        $0F SYNC, interrupt enabled
                      (nterrupt_test.asm):00029         ;   $08 NMI: frame, CC, ignores I and F     $10 SYNC with the line already active
                      (nterrupt_test.asm):00030         ;
                      (nterrupt_test.asm):00031                     include "common.inc"
                      (       common.inc):00001         ; ============================================================
                      (       common.inc):00002         ;  6809 / 6309 functional test suite - shared definitions
                      (       common.inc):00003         ;  GPL-3.0-or-later, see license.txt
                      (       common.inc):00004         ; ============================================================
                      (       common.inc):00005         ;
                      (       common.inc):00006         ; Every test program in this suite follows the same contract, so one
                      (       common.inc):00007         ; harness can run all of them on any CPU core:
                      (       common.inc):00008         ;
                      (       common.inc):00009         ;   * The program is loaded as a Motorola S-record (bin/*.s19). It sets its
                      (       common.inc):00010         ;     own vectors at $FFF0-$FFFF; the harness only has to RESET the CPU.
                      (       common.inc):00011         ;   * The current test number is kept in RAM at TEST_CASE. When a check
                      (       common.inc):00012         ;     fails the program branches to itself ("bne *" etc.), so a failing
                      (       common.inc):00013         ;     core ends up spinning on the very instruction that detected the
                      (       common.inc):00014         ;     error. Look that address up in the matching bin/*.lst listing.
                      (       common.inc):00015         ;   * On success the program writes 0 to DEV_EXIT and then spins on
                      (       common.inc):00016         ;     "bra *". A harness without the test device can stop on that loop
                      (       common.inc):00017         ;     and compare the PC with the "success" symbol in the listing.
                      (       common.inc):00018         ;
                      (       common.inc):00019         ; ---- Test device ($FF00-$FF0F) ------------------------------------------
                      (       common.inc):00020         ;
                      (       common.inc):00021         ; A tiny memory-mapped peripheral the harness provides. Only the interrupt
                      (       common.inc):00022         ; and cycle tests need it; the functional tests only use DEV_EXIT and
                      (       common.inc):00023         ; DEV_PUTC, which are harmless when missing (writes to plain RAM).
                      (       common.inc):00024         ;
     FF00             (       common.inc):00025         DEV_LINES   equ $FF00   ; R/W  interrupt line levels: bit0 IRQ, bit1 FIRQ,
                      (       common.inc):00026                                 ;      bit2 NMI (NMI fires on the 0->1 transition)
     FF01             (       common.inc):00027         DEV_DLINES  equ $FF01   ; R/W  line levels to load into DEV_LINES later...
     FF02             (       common.inc):00028         DEV_DELAY   equ $FF02   ; W    ...after this many CPU cycles (16 bit, big
                      (       common.inc):00029                                 ;      endian, $FF02/$FF03). Writing $FF03 arms it.
     FF04             (       common.inc):00030         DEV_CYC0    equ $FF04   ; W    latch the cycle counter (start mark)
     FF05             (       common.inc):00031         DEV_CYC1    equ $FF05   ; W    latch the cycle counter (end mark)
     FF06             (       common.inc):00032         DEV_CYCD    equ $FF06   ; R    16 bit: end mark - start mark ($FF06/$FF07)
     FF08             (       common.inc):00033         DEV_PUTC    equ $FF08   ; W    write a character to the harness console
     FF0F             (       common.inc):00034         DEV_EXIT    equ $FF0F   ; W    stop: 0 = all tests passed, else = failure
                      (       common.inc):00035         ;
     0001             (       common.inc):00036         LINE_IRQ    equ $01
     0002             (       common.inc):00037         LINE_FIRQ   equ $02
     0004             (       common.inc):00038         LINE_NMI    equ $04
                      (       common.inc):00039         ;
                      (       common.inc):00040         ; ---- Memory map shared by all programs ----------------------------------
                      (       common.inc):00041         ;
     0100             (       common.inc):00042         TEST_CASE   equ $0100   ; current test number (byte)
     0101             (       common.inc):00043         TEST_SUB    equ $0101   ; optional sub-step / loop counter for diagnosis
     0110             (       common.inc):00044         SCRATCH     equ $0110   ; general purpose scratch RAM $0110-$01FF
     0002             (       common.inc):00045         DP_PAGE     equ $02     ; direct page used by direct mode tests ($0200-$02FF)
     0300             (       common.inc):00046         DATA        equ $0300   ; data area $0300-$07FF
     0A00             (       common.inc):00047         USTACK      equ $0A00   ; top of user stack (U)
     0C00             (       common.inc):00048         SSTACK      equ $0C00   ; top of system stack (S)
     1000             (       common.inc):00049         CODE        equ $1000   ; programs start here
                      (       common.inc):00050         ;
                      (       common.inc):00051         ; ---- Condition code bits ------------------------------------------------
                      (       common.inc):00052         ;
     0001             (       common.inc):00053         CC_C        equ $01
     0002             (       common.inc):00054         CC_V        equ $02
     0004             (       common.inc):00055         CC_Z        equ $04
     0008             (       common.inc):00056         CC_N        equ $08
     0010             (       common.inc):00057         CC_I        equ $10
     0020             (       common.inc):00058         CC_H        equ $20
     0040             (       common.inc):00059         CC_F        equ $40
     0080             (       common.inc):00060         CC_E        equ $80
                      (       common.inc):00061         ;
                      (       common.inc):00062         ; ---- Macros -------------------------------------------------------------
                      (       common.inc):00063         ;
                      (       common.inc):00064         ; Start test number \1. Leaves A and CC changed.
0000                  (       common.inc):00065         test        macro
                      (       common.inc):00066                     lda #\1
                      (       common.inc):00067                     sta TEST_CASE
                      (       common.inc):00068                     clr TEST_SUB
                      (       common.inc):00069                     endm
                      (       common.inc):00070         ;
                      (       common.inc):00071         ; Set CC to exactly \1 without touching any other register.
0000                  (       common.inc):00072         set_cc      macro
                      (       common.inc):00073                     andcc #$00
                      (       common.inc):00074                     orcc #\1
                      (       common.inc):00075                     endm
                      (       common.inc):00076         ;
                      (       common.inc):00077         ; Fail unless CC equals \1 exactly. Preserves all registers and CC.
0000                  (       common.inc):00078         chk_cc      macro
                      (       common.inc):00079                     pshs cc,a
                      (       common.inc):00080                     lda ,s
                      (       common.inc):00081                     cmpa #\1
                      (       common.inc):00082                     bne *
                      (       common.inc):00083                     puls cc,a
                      (       common.inc):00084                     endm
                      (       common.inc):00085         ;
                      (       common.inc):00086         ; Fail unless (CC & \2) == \1. Preserves all registers and CC.
0000                  (       common.inc):00087         chk_ccm     macro
                      (       common.inc):00088                     pshs cc,a
                      (       common.inc):00089                     lda ,s
                      (       common.inc):00090                     anda #\2
                      (       common.inc):00091                     cmpa #\1
                      (       common.inc):00092                     bne *
                      (       common.inc):00093                     puls cc,a
                      (       common.inc):00094                     endm
                      (       common.inc):00095         ;
                      (       common.inc):00096         ; Fail unless register equals the immediate value. Each preserves CC.
0000                  (       common.inc):00097         chk_a       macro
                      (       common.inc):00098                     pshs cc
                      (       common.inc):00099                     cmpa #\1
                      (       common.inc):00100                     bne *
                      (       common.inc):00101                     puls cc
                      (       common.inc):00102                     endm
0000                  (       common.inc):00103         chk_b       macro
                      (       common.inc):00104                     pshs cc
                      (       common.inc):00105                     cmpb #\1
                      (       common.inc):00106                     bne *
                      (       common.inc):00107                     puls cc
                      (       common.inc):00108                     endm
0000                  (       common.inc):00109         chk_d       macro
                      (       common.inc):00110                     pshs cc
                      (       common.inc):00111                     cmpd #\1
                      (       common.inc):00112                     bne *
                      (       common.inc):00113                     puls cc
                      (       common.inc):00114                     endm
0000                  (       common.inc):00115         chk_x       macro
                      (       common.inc):00116                     pshs cc
                      (       common.inc):00117                     cmpx #\1
                      (       common.inc):00118                     bne *
                      (       common.inc):00119                     puls cc
                      (       common.inc):00120                     endm
0000                  (       common.inc):00121         chk_y       macro
                      (       common.inc):00122                     pshs cc
                      (       common.inc):00123                     cmpy #\1
                      (       common.inc):00124                     bne *
                      (       common.inc):00125                     puls cc
                      (       common.inc):00126                     endm
0000                  (       common.inc):00127         chk_u       macro
                      (       common.inc):00128                     pshs cc
                      (       common.inc):00129                     cmpu #\1
                      (       common.inc):00130                     bne *
                      (       common.inc):00131                     puls cc
                      (       common.inc):00132                     endm
                      (       common.inc):00133         ; S cannot be checked with pshs/puls around it; use the plain compare.
0000                  (       common.inc):00134         chk_s       macro
                      (       common.inc):00135                     cmps #\1
                      (       common.inc):00136                     bne *
                      (       common.inc):00137                     endm
0000                  (       common.inc):00138         chk_dp      macro
                      (       common.inc):00139                     pshs cc,a
                      (       common.inc):00140                     tfr dp,a
                      (       common.inc):00141                     cmpa #\1
                      (       common.inc):00142                     bne *
                      (       common.inc):00143                     puls cc,a
                      (       common.inc):00144                     endm
                      (       common.inc):00145         ;
                      (       common.inc):00146         ; Fail unless the byte at address \1 equals \2. Preserves registers and CC.
0000                  (       common.inc):00147         chk_mem     macro
                      (       common.inc):00148                     pshs cc,a
                      (       common.inc):00149                     lda \1
                      (       common.inc):00150                     cmpa #\2
                      (       common.inc):00151                     bne *
                      (       common.inc):00152                     puls cc,a
                      (       common.inc):00153                     endm
0000                  (       common.inc):00154         chk_mem16   macro
                      (       common.inc):00155                     pshs cc,d
                      (       common.inc):00156                     ldd \1
                      (       common.inc):00157                     cmpd #\2
                      (       common.inc):00158                     bne *
                      (       common.inc):00159                     puls cc,d
                      (       common.inc):00160                     endm
                      (       common.inc):00161         ;
                      (       common.inc):00162         ; Report success to the harness and stop.
0000                  (       common.inc):00163         pass        macro
                      (       common.inc):00164                     lda #$FF
                      (       common.inc):00165                     sta TEST_CASE
                      (       common.inc):00166                     clr DEV_EXIT
0000                  (       common.inc):00167         success     bra success
                      (       common.inc):00168                     endm
                      (nterrupt_test.asm):00032         ;
     0110             (nterrupt_test.asm):00033         IRQ_VEC     equ SCRATCH         ; RAM vectors (the ROM vectors jump through)
     0112             (nterrupt_test.asm):00034         FIRQ_VEC    equ SCRATCH+2
     0114             (nterrupt_test.asm):00035         NMI_VEC     equ SCRATCH+4
     0116             (nterrupt_test.asm):00036         LOGP        equ SCRATCH+6       ; log write pointer
     0118             (nterrupt_test.asm):00037         HCC         equ SCRATCH+8       ; CC seen inside the last handler
     0119             (nterrupt_test.asm):00038         COUNT       equ SCRATCH+9
     011A             (nterrupt_test.asm):00039         SAVE_S      equ SCRATCH+10
     0120             (nterrupt_test.asm):00040         FRAME       equ SCRATCH+$10     ; copy of the last interrupt frame (12 bytes)
     0130             (nterrupt_test.asm):00041         LOG         equ SCRATCH+$20     ; handler log, one letter per interrupt
                      (nterrupt_test.asm):00042         ;
                      (nterrupt_test.asm):00043                     org CODE
                      (nterrupt_test.asm):00044         ; ==========================================================================
                      (nterrupt_test.asm):00045         ; $01 - NMI must not be taken before S has been loaded
                      (nterrupt_test.asm):00046         ; ==========================================================================
1000 8601             (nterrupt_test.asm):00047         start       lda #$01
1002 B70100           (nterrupt_test.asm):00048                     sta TEST_CASE
1005 8604             (nterrupt_test.asm):00049                     lda #LINE_NMI
1007 B7FF00           (nterrupt_test.asm):00050                     sta DEV_LINES       ; NMI edge with NMI still disarmed
100A 12               (nterrupt_test.asm):00051                     nop
100B 12               (nterrupt_test.asm):00052                     nop
100C 12               (nterrupt_test.asm):00053                     nop
100D 12               (nterrupt_test.asm):00054                     nop
100E 12               (nterrupt_test.asm):00055                     nop                 ; NMI_VEC points at a trap until here
100F 8E10F0           (nterrupt_test.asm):00056                     ldx #nmi_late
1012 BF0114           (nterrupt_test.asm):00057                     stx NMI_VEC
1015 7FFF00           (nterrupt_test.asm):00058                     clr DEV_LINES
1018 10CE0C00         (nterrupt_test.asm):00059                     lds #SSTACK         ; arms NMI. Whether the edge seen while
101C CE0A00           (nterrupt_test.asm):00060                     ldu #USTACK         ; disarmed is taken now is not defined.
101F 12               (nterrupt_test.asm):00061                     nop
1020 12               (nterrupt_test.asm):00062                     nop
1021 12               (nterrupt_test.asm):00063                     nop
1022 8E10D7           (nterrupt_test.asm):00064                     ldx #nmi_handler
1025 BF0114           (nterrupt_test.asm):00065                     stx NMI_VEC
1028 8E108B           (nterrupt_test.asm):00066                     ldx #irq_handler
102B BF0110           (nterrupt_test.asm):00067                     stx IRQ_VEC
102E 8E10AD           (nterrupt_test.asm):00068                     ldx #firq_handler
1031 BF0112           (nterrupt_test.asm):00069                     stx FIRQ_VEC
1034 8602             (nterrupt_test.asm):00070                     lda #DP_PAGE
1036 1F8B             (nterrupt_test.asm):00071                     tfr a,dp
1038 8E1041           (nterrupt_test.asm):00072                     ldx #banner
103B BD1059           (nterrupt_test.asm):00073                     jsr puts
103E 1600B3           (nterrupt_test.asm):00074                     lbra t02
                      (nterrupt_test.asm):00075         ;
1041 4D43363830392069 (nterrupt_test.asm):00076         banner      fcc "MC6809 interrupt test"
     6E74657272757074
     2074657374
1056 0D0A00           (nterrupt_test.asm):00077                     fcb 13,10,0
                      (nterrupt_test.asm):00078         ;
1059 A680             (nterrupt_test.asm):00079         puts        lda ,x+
105B 2705             (nterrupt_test.asm):00080                     beq puts_done
105D B7FF08           (nterrupt_test.asm):00081                     sta DEV_PUTC
1060 20F7             (nterrupt_test.asm):00082                     bra puts
1062 39               (nterrupt_test.asm):00083         puts_done   rts
                      (nterrupt_test.asm):00084         ;
                      (nterrupt_test.asm):00085         ; Clear the log
1063 3410             (nterrupt_test.asm):00086         log_clear   pshs x
1065 8E0130           (nterrupt_test.asm):00087                     ldx #LOG
1068 BF0116           (nterrupt_test.asm):00088                     stx LOGP
106B 6F84             (nterrupt_test.asm):00089                     clr ,x
106D 3590             (nterrupt_test.asm):00090                     puls x,pc
                      (nterrupt_test.asm):00091         ; Append the letter in A to the log (keeps it zero terminated)
106F 3410             (nterrupt_test.asm):00092         log_add     pshs x
1071 BE0116           (nterrupt_test.asm):00093                     ldx LOGP
1074 A780             (nterrupt_test.asm):00094                     sta ,x+
1076 6F84             (nterrupt_test.asm):00095                     clr ,x
1078 BF0116           (nterrupt_test.asm):00096                     stx LOGP
107B 3590             (nterrupt_test.asm):00097                     puls x,pc
                      (nterrupt_test.asm):00098         ; Fail unless the log equals the zero terminated string at X
107D 108E0130         (nterrupt_test.asm):00099         log_check   ldy #LOG
1081 A680             (nterrupt_test.asm):00100         log_check1  lda ,x+
1083 A1A0             (nterrupt_test.asm):00101                     cmpa ,y+
1085 26FE             (nterrupt_test.asm):00102                     bne *               ; log differs: see LOG at $0130
1087 4D               (nterrupt_test.asm):00103                     tsta
1088 26F7             (nterrupt_test.asm):00104                     bne log_check1
108A 39               (nterrupt_test.asm):00105                     rts
                      (nterrupt_test.asm):00106         ;
                      (nterrupt_test.asm):00107         ; ---- interrupt handlers ---------------------------------------------------
                      (nterrupt_test.asm):00108         ;
                      (nterrupt_test.asm):00109         ; IRQ: entire state stacked. Record CC and the frame, drop the line.
108B 1FA8             (nterrupt_test.asm):00110         irq_handler tfr cc,a
108D B70118           (nterrupt_test.asm):00111                     sta HCC
1090 8E0120           (nterrupt_test.asm):00112                     ldx #FRAME
1093 1F42             (nterrupt_test.asm):00113                     tfr s,y
1095 C60C             (nterrupt_test.asm):00114                     ldb #12
1097 A6A0             (nterrupt_test.asm):00115         irq_copy    lda ,y+
1099 A780             (nterrupt_test.asm):00116                     sta ,x+
109B 5A               (nterrupt_test.asm):00117                     decb
109C 26F9             (nterrupt_test.asm):00118                     bne irq_copy
109E 8649             (nterrupt_test.asm):00119                     lda #'I'
10A0 BD106F           (nterrupt_test.asm):00120                     jsr log_add
10A3 B6FF00           (nterrupt_test.asm):00121                     lda DEV_LINES
10A6 84FE             (nterrupt_test.asm):00122                     anda #~LINE_IRQ&$FF
10A8 B7FF00           (nterrupt_test.asm):00123                     sta DEV_LINES
10AB 12               (nterrupt_test.asm):00124                     nop
10AC 3B               (nterrupt_test.asm):00125                     rti
                      (nterrupt_test.asm):00126         ;
                      (nterrupt_test.asm):00127         ; FIRQ: only CC and PC stacked, so save what the handler uses.
10AD                  (nterrupt_test.asm):00128         firq_handler
10AD 3401             (nterrupt_test.asm):00129                     pshs cc
10AF 3436             (nterrupt_test.asm):00130                     pshs y,x,b,a
10B1 A666             (nterrupt_test.asm):00131                     lda 6,s
10B3 B70118           (nterrupt_test.asm):00132                     sta HCC
10B6 8E0120           (nterrupt_test.asm):00133                     ldx #FRAME
10B9 3167             (nterrupt_test.asm):00134                     leay 7,s
10BB C603             (nterrupt_test.asm):00135                     ldb #3
10BD A6A0             (nterrupt_test.asm):00136         firq_copy   lda ,y+
10BF A780             (nterrupt_test.asm):00137                     sta ,x+
10C1 5A               (nterrupt_test.asm):00138                     decb
10C2 26F9             (nterrupt_test.asm):00139                     bne firq_copy
10C4 8646             (nterrupt_test.asm):00140                     lda #'F'
10C6 BD106F           (nterrupt_test.asm):00141                     jsr log_add
10C9 B6FF00           (nterrupt_test.asm):00142                     lda DEV_LINES
10CC 84FD             (nterrupt_test.asm):00143                     anda #~LINE_FIRQ&$FF
10CE B7FF00           (nterrupt_test.asm):00144                     sta DEV_LINES
10D1 12               (nterrupt_test.asm):00145                     nop
10D2 3536             (nterrupt_test.asm):00146                     puls a,b,x,y
10D4 3261             (nterrupt_test.asm):00147                     leas 1,s
10D6 3B               (nterrupt_test.asm):00148                     rti
                      (nterrupt_test.asm):00149         ;
                      (nterrupt_test.asm):00150         ; NMI: entire state stacked. The line is left alone (edge triggered).
10D7 1FA8             (nterrupt_test.asm):00151         nmi_handler tfr cc,a
10D9 B70118           (nterrupt_test.asm):00152                     sta HCC
10DC 8E0120           (nterrupt_test.asm):00153                     ldx #FRAME
10DF 1F42             (nterrupt_test.asm):00154                     tfr s,y
10E1 C60C             (nterrupt_test.asm):00155                     ldb #12
10E3 A6A0             (nterrupt_test.asm):00156         nmi_copy    lda ,y+
10E5 A780             (nterrupt_test.asm):00157                     sta ,x+
10E7 5A               (nterrupt_test.asm):00158                     decb
10E8 26F9             (nterrupt_test.asm):00159                     bne nmi_copy
10EA 864E             (nterrupt_test.asm):00160                     lda #'N'
10EC BD106F           (nterrupt_test.asm):00161                     jsr log_add
10EF 3B               (nterrupt_test.asm):00162                     rti
                      (nterrupt_test.asm):00163         ;
                      (nterrupt_test.asm):00164         ; NMI that arrives right after the first LDS (allowed, see test $01)
10F0 7C0119           (nterrupt_test.asm):00165         nmi_late    inc COUNT
10F3 3B               (nterrupt_test.asm):00166                     rti
                      (nterrupt_test.asm):00167         ;
                      (nterrupt_test.asm):00168         ; ==========================================================================
                      (nterrupt_test.asm):00169         ; $02 - IRQ
                      (nterrupt_test.asm):00170         ; ==========================================================================
10F4                  (nterrupt_test.asm):00171         t02         test $02
10F4 8602             (             test):00001                     lda #$02
10F6 B70100           (             test):00002                     sta TEST_CASE
10F9 7F0101           (             test):00003                     clr TEST_SUB
10FC BD1063           (nterrupt_test.asm):00172                     jsr log_clear
10FF CC1122           (nterrupt_test.asm):00173                     ldd #$1122
1102 8E3344           (nterrupt_test.asm):00174                     ldx #$3344
1105 108E5566         (nterrupt_test.asm):00175                     ldy #$5566
1109 CE7788           (nterrupt_test.asm):00176                     ldu #$7788
110C 10FF011A         (nterrupt_test.asm):00177                     sts SAVE_S
                      (nterrupt_test.asm):00178                     set_cc CC_F|CC_N|CC_C
1110 1C00             (           set_cc):00001                     andcc #$00
1112 1A49             (           set_cc):00002                     orcc #CC_F|CC_N|CC_C
1114 8601             (nterrupt_test.asm):00179                     lda #LINE_IRQ
1116 B7FF00           (nterrupt_test.asm):00180                     sta DEV_LINES
1119 12               (nterrupt_test.asm):00181                     nop
