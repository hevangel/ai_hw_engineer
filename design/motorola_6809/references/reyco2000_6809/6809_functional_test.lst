                      (nctional_test.asm):00001         ; ============================================================
                      (nctional_test.asm):00002         ;  MC6809 functional test
                      (nctional_test.asm):00003         ;  GPL-3.0-or-later, see license.txt
                      (nctional_test.asm):00004         ; ============================================================
                      (nctional_test.asm):00005         ;
                      (nctional_test.asm):00006         ; Tests every documented MC6809 instruction and addressing mode: results,
                      (nctional_test.asm):00007         ; every defined condition code bit, and the side effects (stack frames,
                      (nctional_test.asm):00008         ; auto increment/decrement, register updates). Undefined flags (H after a
                      (nctional_test.asm):00009         ; subtract or shift, V after DAA, ...) are not checked.
                      (nctional_test.asm):00010         ;
                      (nctional_test.asm):00011         ; Runs unchanged on an HD6309 in emulation mode, which must behave the same.
                      (nctional_test.asm):00012         ; Uses no interrupts and needs no test device: a failing check spins on
                      (nctional_test.asm):00013         ; itself ("bne *"), success writes 0 to DEV_EXIT and spins at "success".
                      (nctional_test.asm):00014         ;
                      (nctional_test.asm):00015         ; Assemble:  lwasm --6809 --format=srec --list=bin/6809_functional_test.lst
                      (nctional_test.asm):00016         ;                  -o bin/6809_functional_test.s19 src/6809_functional_test.asm
                      (nctional_test.asm):00017         ;            (or just "make")
                      (nctional_test.asm):00018         ;
                      (nctional_test.asm):00019         ; Test numbers (TEST_CASE at $0100) - see the listing for each check:
                      (nctional_test.asm):00020         ;   $01 basic branches and CC transfer      $10 8 bit ALU vectors, A and B
                      (nctional_test.asm):00021         ;   $02 conditional branches, short          $11 8 bit unary vectors, A/B/mem
                      (nctional_test.asm):00022         ;   $03 conditional branches, long           $12 16 bit ADDD/SUBD/CMPx vectors
                      (nctional_test.asm):00023         ;   $04 far branches, BSR/LBSR/JSR/RTS/JMP   $13 DAA, all inputs
                      (nctional_test.asm):00024         ;   $05 8 bit loads and stores               $14 MUL, SEX, ABX
                      (nctional_test.asm):00025         ;   $06 16 bit loads and stores              $15 every opcode, every mode: A/B
                      (nctional_test.asm):00026         ;   $07 indexed modes, non-indirect          $16 every opcode, every mode: 16 bit
                      (nctional_test.asm):00027         ;   $08 indexed modes, indirect, PCR, [ext]  $17 every opcode, every mode: memory
                      (nctional_test.asm):00028         ;   $09 LEAX/LEAY/LEAU/LEAS                  $18 direct page register
                      (nctional_test.asm):00029         ;   $0A TFR / EXG                            $19 ANDCC/ORCC, NOP, BRN/LBRN
                      (nctional_test.asm):00030         ;   $0B PSHS/PULS/PSHU/PULU                  $1A SWI/SWI2/SWI3/RTI
                      (nctional_test.asm):00031         ;
                      (nctional_test.asm):00032                     include "common.inc"
                      (       common.inc):00001         ; ============================================================
                      (       common.inc):00002         ;  6809 / 6309 functional test suite - shared definitions
                      (       common.inc):00003         ;  GPL-3.0-or-later, see license.txt
                      (       common.inc):00004         ; ============================================================
                      (       common.inc):00005         ;
                      (       common.inc):00006         ; Every test program in this suite follows the same contract, so one
                      (       common.inc):00007         ; harness can run all of them on any CPU core:
                      (       common.inc):00008         ;
                      (       common.inc):00009         ;   * The program is loaded as a Motorola S-record (bin/*.s19). It sets its
                      (       common.inc):00010         ;     own vectors at $FFF0-$FFFF; the harness only has to RESET the CPU.
                      (       common.inc):00011         ;   * The current test number is kept in RAM at TEST_CASE. When a check
                      (       common.inc):00012         ;     fails the program branches to itself ("bne *" etc.), so a failing
                      (       common.inc):00013         ;     core ends up spinning on the very instruction that detected the
                      (       common.inc):00014         ;     error. Look that address up in the matching bin/*.lst listing.
                      (       common.inc):00015         ;   * On success the program writes 0 to DEV_EXIT and then spins on
                      (       common.inc):00016         ;     "bra *". A harness without the test device can stop on that loop
                      (       common.inc):00017         ;     and compare the PC with the "success" symbol in the listing.
                      (       common.inc):00018         ;
                      (       common.inc):00019         ; ---- Test device ($FF00-$FF0F) ------------------------------------------
                      (       common.inc):00020         ;
                      (       common.inc):00021         ; A tiny memory-mapped peripheral the harness provides. Only the interrupt
                      (       common.inc):00022         ; and cycle tests need it; the functional tests only use DEV_EXIT and
                      (       common.inc):00023         ; DEV_PUTC, which are harmless when missing (writes to plain RAM).
                      (       common.inc):00024         ;
     FF00             (       common.inc):00025         DEV_LINES   equ $FF00   ; R/W  interrupt line levels: bit0 IRQ, bit1 FIRQ,
                      (       common.inc):00026                                 ;      bit2 NMI (NMI fires on the 0->1 transition)
     FF01             (       common.inc):00027         DEV_DLINES  equ $FF01   ; R/W  line levels to load into DEV_LINES later...
     FF02             (       common.inc):00028         DEV_DELAY   equ $FF02   ; W    ...after this many CPU cycles (16 bit, big
                      (       common.inc):00029                                 ;      endian, $FF02/$FF03). Writing $FF03 arms it.
     FF04             (       common.inc):00030         DEV_CYC0    equ $FF04   ; W    latch the cycle counter (start mark)
     FF05             (       common.inc):00031         DEV_CYC1    equ $FF05   ; W    latch the cycle counter (end mark)
     FF06             (       common.inc):00032         DEV_CYCD    equ $FF06   ; R    16 bit: end mark - start mark ($FF06/$FF07)
     FF08             (       common.inc):00033         DEV_PUTC    equ $FF08   ; W    write a character to the harness console
     FF0F             (       common.inc):00034         DEV_EXIT    equ $FF0F   ; W    stop: 0 = all tests passed, else = failure
                      (       common.inc):00035         ;
     0001             (       common.inc):00036         LINE_IRQ    equ $01
     0002             (       common.inc):00037         LINE_FIRQ   equ $02
     0004             (       common.inc):00038         LINE_NMI    equ $04
                      (       common.inc):00039         ;
                      (       common.inc):00040         ; ---- Memory map shared by all programs ----------------------------------
                      (       common.inc):00041         ;
     0100             (       common.inc):00042         TEST_CASE   equ $0100   ; current test number (byte)
     0101             (       common.inc):00043         TEST_SUB    equ $0101   ; optional sub-step / loop counter for diagnosis
     0110             (       common.inc):00044         SCRATCH     equ $0110   ; general purpose scratch RAM $0110-$01FF
     0002             (       common.inc):00045         DP_PAGE     equ $02     ; direct page used by direct mode tests ($0200-$02FF)
     0300             (       common.inc):00046         DATA        equ $0300   ; data area $0300-$07FF
     0A00             (       common.inc):00047         USTACK      equ $0A00   ; top of user stack (U)
     0C00             (       common.inc):00048         SSTACK      equ $0C00   ; top of system stack (S)
     1000             (       common.inc):00049         CODE        equ $1000   ; programs start here
                      (       common.inc):00050         ;
                      (       common.inc):00051         ; ---- Condition code bits ------------------------------------------------
                      (       common.inc):00052         ;
     0001             (       common.inc):00053         CC_C        equ $01
     0002             (       common.inc):00054         CC_V        equ $02
     0004             (       common.inc):00055         CC_Z        equ $04
     0008             (       common.inc):00056         CC_N        equ $08
     0010             (       common.inc):00057         CC_I        equ $10
     0020             (       common.inc):00058         CC_H        equ $20
     0040             (       common.inc):00059         CC_F        equ $40
     0080             (       common.inc):00060         CC_E        equ $80
                      (       common.inc):00061         ;
                      (       common.inc):00062         ; ---- Macros -------------------------------------------------------------
                      (       common.inc):00063         ;
                      (       common.inc):00064         ; Start test number \1. Leaves A and CC changed.
0000                  (       common.inc):00065         test        macro
                      (       common.inc):00066                     lda #\1
                      (       common.inc):00067                     sta TEST_CASE
                      (       common.inc):00068                     clr TEST_SUB
                      (       common.inc):00069                     endm
                      (       common.inc):00070         ;
                      (       common.inc):00071         ; Set CC to exactly \1 without touching any other register.
0000                  (       common.inc):00072         set_cc      macro
                      (       common.inc):00073                     andcc #$00
                      (       common.inc):00074                     orcc #\1
                      (       common.inc):00075                     endm
                      (       common.inc):00076         ;
                      (       common.inc):00077         ; Fail unless CC equals \1 exactly. Preserves all registers and CC.
0000                  (       common.inc):00078         chk_cc      macro
                      (       common.inc):00079                     pshs cc,a
                      (       common.inc):00080                     lda ,s
                      (       common.inc):00081                     cmpa #\1
                      (       common.inc):00082                     bne *
                      (       common.inc):00083                     puls cc,a
                      (       common.inc):00084                     endm
                      (       common.inc):00085         ;
                      (       common.inc):00086         ; Fail unless (CC & \2) == \1. Preserves all registers and CC.
0000                  (       common.inc):00087         chk_ccm     macro
                      (       common.inc):00088                     pshs cc,a
                      (       common.inc):00089                     lda ,s
                      (       common.inc):00090                     anda #\2
                      (       common.inc):00091                     cmpa #\1
                      (       common.inc):00092                     bne *
                      (       common.inc):00093                     puls cc,a
                      (       common.inc):00094                     endm
                      (       common.inc):00095         ;
                      (       common.inc):00096         ; Fail unless register equals the immediate value. Each preserves CC.
0000                  (       common.inc):00097         chk_a       macro
                      (       common.inc):00098                     pshs cc
                      (       common.inc):00099                     cmpa #\1
                      (       common.inc):00100                     bne *
                      (       common.inc):00101                     puls cc
                      (       common.inc):00102                     endm
0000                  (       common.inc):00103         chk_b       macro
                      (       common.inc):00104                     pshs cc
                      (       common.inc):00105                     cmpb #\1
                      (       common.inc):00106                     bne *
                      (       common.inc):00107                     puls cc
                      (       common.inc):00108                     endm
0000                  (       common.inc):00109         chk_d       macro
                      (       common.inc):00110                     pshs cc
                      (       common.inc):00111                     cmpd #\1
                      (       common.inc):00112                     bne *
                      (       common.inc):00113                     puls cc
                      (       common.inc):00114                     endm
0000                  (       common.inc):00115         chk_x       macro
                      (       common.inc):00116                     pshs cc
                      (       common.inc):00117                     cmpx #\1
                      (       common.inc):00118                     bne *
                      (       common.inc):00119                     puls cc
                      (       common.inc):00120                     endm
0000                  (       common.inc):00121         chk_y       macro
                      (       common.inc):00122                     pshs cc
                      (       common.inc):00123                     cmpy #\1
                      (       common.inc):00124                     bne *
                      (       common.inc):00125                     puls cc
                      (       common.inc):00126                     endm
0000                  (       common.inc):00127         chk_u       macro
                      (       common.inc):00128                     pshs cc
                      (       common.inc):00129                     cmpu #\1
                      (       common.inc):00130                     bne *
                      (       common.inc):00131                     puls cc
                      (       common.inc):00132                     endm
                      (       common.inc):00133         ; S cannot be checked with pshs/puls around it; use the plain compare.
0000                  (       common.inc):00134         chk_s       macro
                      (       common.inc):00135                     cmps #\1
                      (       common.inc):00136                     bne *
                      (       common.inc):00137                     endm
0000                  (       common.inc):00138         chk_dp      macro
                      (       common.inc):00139                     pshs cc,a
                      (       common.inc):00140                     tfr dp,a
                      (       common.inc):00141                     cmpa #\1
                      (       common.inc):00142                     bne *
                      (       common.inc):00143                     puls cc,a
                      (       common.inc):00144                     endm
                      (       common.inc):00145         ;
                      (       common.inc):00146         ; Fail unless the byte at address \1 equals \2. Preserves registers and CC.
0000                  (       common.inc):00147         chk_mem     macro
                      (       common.inc):00148                     pshs cc,a
                      (       common.inc):00149                     lda \1
                      (       common.inc):00150                     cmpa #\2
                      (       common.inc):00151                     bne *
                      (       common.inc):00152                     puls cc,a
                      (       common.inc):00153                     endm
0000                  (       common.inc):00154         chk_mem16   macro
                      (       common.inc):00155                     pshs cc,d
                      (       common.inc):00156                     ldd \1
                      (       common.inc):00157                     cmpd #\2
                      (       common.inc):00158                     bne *
                      (       common.inc):00159                     puls cc,d
                      (       common.inc):00160                     endm
                      (       common.inc):00161         ;
                      (       common.inc):00162         ; Report success to the harness and stop.
0000                  (       common.inc):00163         pass        macro
                      (       common.inc):00164                     lda #$FF
                      (       common.inc):00165                     sta TEST_CASE
                      (       common.inc):00166                     clr DEV_EXIT
0000                  (       common.inc):00167         success     bra success
                      (       common.inc):00168                     endm
                      (nctional_test.asm):00033                     include "test_macros.inc"
                      (  test_macros.inc):00001         ; ============================================================
                      (  test_macros.inc):00002         ;  6809 / 6309 functional test suite - shared test macros
                      (  test_macros.inc):00003         ;  GPL-3.0-or-later, see license.txt
                      (  test_macros.inc):00004         ; ============================================================
                      (  test_macros.inc):00005         ;
                      (  test_macros.inc):00006         ; Loops that run one instruction over a vector table (vectors_*.inc), and
                      (  test_macros.inc):00007         ; blocks that try one instruction in every addressing mode. A program that
                      (  test_macros.inc):00008         ; includes this file must define:
                      (  test_macros.inc):00009         ;   VAR, VAR16   extended mode operands (byte, word)
                      (  test_macros.inc):00010         ;   DPV, DPV16   direct page operands (with DP = DP_PAGE)
                      (  test_macros.inc):00011         ;
                      (  test_macros.inc):00012         ; The vector loops trap with Y (X for alu16x) pointing at the failing
                      (  test_macros.inc):00013         ; vector; the tables are in the listing.
                      (  test_macros.inc):00014         ;
                      (  test_macros.inc):00015         ; Macro parameters cannot contain commas or spaces (lwasm), so register
                      (  test_macros.inc):00016         ; operands are passed separately where needed.
                      (  test_macros.inc):00017         ;
                      (  test_macros.inc):00018         ; ---- vector loops ---------------------------------------------------------
                      (  test_macros.inc):00019         ;
                      (  test_macros.inc):00020         ; Two operands on A or B. Vector: value, operand, CCin, result, CC result.
                      (  test_macros.inc):00021         ; \1 instruction, \2 table, \3 table end, \4 mask of the CC bits checked
0000                  (  test_macros.inc):00022         alu8a       macro
                      (  test_macros.inc):00023                     ldy #\2
0000                  (  test_macros.inc):00024         @loop       lda 2,y
                      (  test_macros.inc):00025                     pshs a
                      (  test_macros.inc):00026                     lda ,y
                      (  test_macros.inc):00027                     puls cc
                      (  test_macros.inc):00028                     \1 1,y
                      (  test_macros.inc):00029                     pshs cc
                      (  test_macros.inc):00030                     cmpa 3,y
                      (  test_macros.inc):00031                     bne *               ; wrong result
                      (  test_macros.inc):00032                     puls a
                      (  test_macros.inc):00033                     eora 4,y
                      (  test_macros.inc):00034                     anda #\4
                      (  test_macros.inc):00035                     bne *               ; wrong flags
                      (  test_macros.inc):00036                     leay 5,y
                      (  test_macros.inc):00037                     cmpy #\3
                      (  test_macros.inc):00038                     bne @loop
                      (  test_macros.inc):00039                     endm
0000                  (  test_macros.inc):00040         alu8b       macro
                      (  test_macros.inc):00041                     ldy #\2
0000                  (  test_macros.inc):00042         @loop       lda 2,y
                      (  test_macros.inc):00043                     pshs a
                      (  test_macros.inc):00044                     ldb ,y
                      (  test_macros.inc):00045                     puls cc
                      (  test_macros.inc):00046                     \1 1,y
                      (  test_macros.inc):00047                     pshs cc
                      (  test_macros.inc):00048                     cmpb 3,y
                      (  test_macros.inc):00049                     bne *
                      (  test_macros.inc):00050                     puls a
                      (  test_macros.inc):00051                     eora 4,y
                      (  test_macros.inc):00052                     anda #\4
                      (  test_macros.inc):00053                     bne *
                      (  test_macros.inc):00054                     leay 5,y
                      (  test_macros.inc):00055                     cmpy #\3
                      (  test_macros.inc):00056                     bne @loop
                      (  test_macros.inc):00057                     endm
                      (  test_macros.inc):00058         ;
                      (  test_macros.inc):00059         ; Two operands on any 8 bit register that is neither A nor CC (HD6309 E,F).
                      (  test_macros.inc):00060         ; \1 load, \2 instruction, \3 compare, \4 table, \5 end, \6 mask
0000                  (  test_macros.inc):00061         alu8r       macro
                      (  test_macros.inc):00062                     ldy #\4
0000                  (  test_macros.inc):00063         @loop       \1 ,y
                      (  test_macros.inc):00064                     lda 2,y
                      (  test_macros.inc):00065                     tfr a,cc
                      (  test_macros.inc):00066                     \2 1,y
                      (  test_macros.inc):00067                     tfr cc,a
                      (  test_macros.inc):00068                     \3 3,y
                      (  test_macros.inc):00069                     bne *
                      (  test_macros.inc):00070                     eora 4,y
                      (  test_macros.inc):00071                     anda #\6
                      (  test_macros.inc):00072                     bne *
                      (  test_macros.inc):00073                     leay 5,y
                      (  test_macros.inc):00074                     cmpy #\5
                      (  test_macros.inc):00075                     bne @loop
                      (  test_macros.inc):00076                     endm
                      (  test_macros.inc):00077         ;
                      (  test_macros.inc):00078         ; Register to register (HD6309), 8 bit: "\1 \2,\3" with \3 = A, \2 = B.
                      (  test_macros.inc):00079         ; \4 table, \5 end, \6 mask
0000                  (  test_macros.inc):00080         alu8rr      macro
                      (  test_macros.inc):00081                     ldy #\4
0000                  (  test_macros.inc):00082         @loop       lda 2,y
                      (  test_macros.inc):00083                     pshs a
                      (  test_macros.inc):00084                     ldd ,y
                      (  test_macros.inc):00085                     puls cc
                      (  test_macros.inc):00086                     \1 \2,\3
                      (  test_macros.inc):00087                     pshs cc
                      (  test_macros.inc):00088                     cmpa 3,y
                      (  test_macros.inc):00089                     bne *
                      (  test_macros.inc):00090                     puls a
                      (  test_macros.inc):00091                     eora 4,y
                      (  test_macros.inc):00092                     anda #\6
                      (  test_macros.inc):00093                     bne *
                      (  test_macros.inc):00094                     leay 5,y
                      (  test_macros.inc):00095                     cmpy #\5
                      (  test_macros.inc):00096                     bne @loop
                      (  test_macros.inc):00097                     endm
                      (  test_macros.inc):00098         ;
                      (  test_macros.inc):00099         ; One operand. Vector: value, CCin, result, CC result.
                      (  test_macros.inc):00100         ; \1 instruction, \2 table, \3 end, \4 mask
0000                  (  test_macros.inc):00101         un8a        macro
                      (  test_macros.inc):00102                     ldy #\2
0000                  (  test_macros.inc):00103         @loop       lda 1,y
                      (  test_macros.inc):00104                     pshs a
                      (  test_macros.inc):00105                     lda ,y
                      (  test_macros.inc):00106                     puls cc
                      (  test_macros.inc):00107                     \1
                      (  test_macros.inc):00108                     pshs cc
                      (  test_macros.inc):00109                     cmpa 2,y
                      (  test_macros.inc):00110                     bne *
                      (  test_macros.inc):00111                     puls a
                      (  test_macros.inc):00112                     eora 3,y
                      (  test_macros.inc):00113                     anda #\4
                      (  test_macros.inc):00114                     bne *
                      (  test_macros.inc):00115                     leay 4,y
                      (  test_macros.inc):00116                     cmpy #\3
                      (  test_macros.inc):00117                     bne @loop
                      (  test_macros.inc):00118                     endm
0000                  (  test_macros.inc):00119         un8b        macro
                      (  test_macros.inc):00120                     ldy #\2
0000                  (  test_macros.inc):00121         @loop       lda 1,y
                      (  test_macros.inc):00122                     pshs a
                      (  test_macros.inc):00123                     ldb ,y
                      (  test_macros.inc):00124                     puls cc
                      (  test_macros.inc):00125                     \1
                      (  test_macros.inc):00126                     pshs cc
                      (  test_macros.inc):00127                     cmpb 2,y
                      (  test_macros.inc):00128                     bne *
                      (  test_macros.inc):00129                     puls a
                      (  test_macros.inc):00130                     eora 3,y
                      (  test_macros.inc):00131                     anda #\4
                      (  test_macros.inc):00132                     bne *
                      (  test_macros.inc):00133                     leay 4,y
                      (  test_macros.inc):00134                     cmpy #\3
                      (  test_macros.inc):00135                     bne @loop
                      (  test_macros.inc):00136                     endm
                      (  test_macros.inc):00137         ; \1 instruction applied to VAR (extended mode)
0000                  (  test_macros.inc):00138         un8m        macro
                      (  test_macros.inc):00139                     ldy #\2
0000                  (  test_macros.inc):00140         @loop       lda ,y
                      (  test_macros.inc):00141                     sta VAR
                      (  test_macros.inc):00142                     lda 1,y
                      (  test_macros.inc):00143                     tfr a,cc
                      (  test_macros.inc):00144                     \1 VAR
                      (  test_macros.inc):00145                     tfr cc,a
                      (  test_macros.inc):00146                     ldb VAR
                      (  test_macros.inc):00147                     cmpb 2,y
                      (  test_macros.inc):00148                     bne *
                      (  test_macros.inc):00149                     eora 3,y
                      (  test_macros.inc):00150                     anda #\4
                      (  test_macros.inc):00151                     bne *
                      (  test_macros.inc):00152                     leay 4,y
                      (  test_macros.inc):00153                     cmpy #\3
                      (  test_macros.inc):00154                     bne @loop
                      (  test_macros.inc):00155                     endm
                      (  test_macros.inc):00156         ; Any 8 bit register that is neither A nor CC.
                      (  test_macros.inc):00157         ; \1 load, \2 instruction, \3 compare, \4 table, \5 end, \6 mask
0000                  (  test_macros.inc):00158         un8r        macro
                      (  test_macros.inc):00159                     ldy #\4
0000                  (  test_macros.inc):00160         @loop       \1 ,y
                      (  test_macros.inc):00161                     lda 1,y
                      (  test_macros.inc):00162                     tfr a,cc
                      (  test_macros.inc):00163                     \2
                      (  test_macros.inc):00164                     tfr cc,a
                      (  test_macros.inc):00165                     \3 2,y
                      (  test_macros.inc):00166                     bne *
                      (  test_macros.inc):00167                     eora 3,y
                      (  test_macros.inc):00168                     anda #\6
                      (  test_macros.inc):00169                     bne *
                      (  test_macros.inc):00170                     leay 4,y
                      (  test_macros.inc):00171                     cmpy #\5
                      (  test_macros.inc):00172                     bne @loop
                      (  test_macros.inc):00173                     endm
                      (  test_macros.inc):00174         ;
                      (  test_macros.inc):00175         ; 16 bit, two operands, on D. Vector: value(2), operand(2), CCin,
                      (  test_macros.inc):00176         ; result(2), CC result. \1 instruction, \2 table, \3 end, \4 mask
0000                  (  test_macros.inc):00177         alu16d      macro
                      (  test_macros.inc):00178                     ldy #\2
0000                  (  test_macros.inc):00179         @loop       lda 4,y
                      (  test_macros.inc):00180                     pshs a
                      (  test_macros.inc):00181                     ldd ,y
                      (  test_macros.inc):00182                     puls cc
                      (  test_macros.inc):00183                     \1 2,y
                      (  test_macros.inc):00184                     pshs cc
                      (  test_macros.inc):00185                     cmpd 5,y
                      (  test_macros.inc):00186                     bne *
                      (  test_macros.inc):00187                     puls a
                      (  test_macros.inc):00188                     eora 7,y
                      (  test_macros.inc):00189                     anda #\4
                      (  test_macros.inc):00190                     bne *
                      (  test_macros.inc):00191                     leay 8,y
                      (  test_macros.inc):00192                     cmpy #\3
                      (  test_macros.inc):00193                     bne @loop
                      (  test_macros.inc):00194                     endm
                      (  test_macros.inc):00195         ; 16 bit, two operands, on a register other than D and Y (CC goes via A).
                      (  test_macros.inc):00196         ; \1 load, \2 instruction, \3 compare, \4 table, \5 end, \6 mask
0000                  (  test_macros.inc):00197         alu16r      macro
                      (  test_macros.inc):00198                     ldy #\4
0000                  (  test_macros.inc):00199         @loop       \1 ,y
                      (  test_macros.inc):00200                     lda 4,y
                      (  test_macros.inc):00201                     tfr a,cc
                      (  test_macros.inc):00202                     \2 2,y
                      (  test_macros.inc):00203                     tfr cc,a
                      (  test_macros.inc):00204                     \3 5,y
                      (  test_macros.inc):00205                     bne *
                      (  test_macros.inc):00206                     eora 7,y
                      (  test_macros.inc):00207                     anda #\6
                      (  test_macros.inc):00208                     bne *
                      (  test_macros.inc):00209                     leay 8,y
                      (  test_macros.inc):00210                     cmpy #\5
                      (  test_macros.inc):00211                     bne @loop
                      (  test_macros.inc):00212                     endm
                      (  test_macros.inc):00213         ; 16 bit one operand. Vector: value(2), CCin, result(2), CC result.
                      (  test_macros.inc):00214         ; on D: \1 instruction, \2 table, \3 end, \4 mask
0000                  (  test_macros.inc):00215         un16d       macro
                      (  test_macros.inc):00216                     ldy #\2
0000                  (  test_macros.inc):00217         @loop       lda 2,y
                      (  test_macros.inc):00218                     pshs a
                      (  test_macros.inc):00219                     ldd ,y
                      (  test_macros.inc):00220                     puls cc
                      (  test_macros.inc):00221                     \1
                      (  test_macros.inc):00222                     pshs cc
                      (  test_macros.inc):00223                     cmpd 3,y
                      (  test_macros.inc):00224                     bne *
                      (  test_macros.inc):00225                     puls a
                      (  test_macros.inc):00226                     eora 5,y
                      (  test_macros.inc):00227                     anda #\4
                      (  test_macros.inc):00228                     bne *
                      (  test_macros.inc):00229                     leay 6,y
                      (  test_macros.inc):00230                     cmpy #\3
                      (  test_macros.inc):00231                     bne @loop
                      (  test_macros.inc):00232                     endm
                      (  test_macros.inc):00233         ; on another register: \1 load, \2 instruction, \3 compare, \4..\6 as above
0000                  (  test_macros.inc):00234         un16r       macro
                      (  test_macros.inc):00235                     ldy #\4
0000                  (  test_macros.inc):00236         @loop       \1 ,y
                      (  test_macros.inc):00237                     lda 2,y
                      (  test_macros.inc):00238                     tfr a,cc
                      (  test_macros.inc):00239                     \2
                      (  test_macros.inc):00240                     tfr cc,a
                      (  test_macros.inc):00241                     \3 3,y
                      (  test_macros.inc):00242                     bne *
                      (  test_macros.inc):00243                     eora 5,y
                      (  test_macros.inc):00244                     anda #\6
                      (  test_macros.inc):00245                     bne *
                      (  test_macros.inc):00246                     leay 6,y
                      (  test_macros.inc):00247                     cmpy #\5
                      (  test_macros.inc):00248                     bne @loop
                      (  test_macros.inc):00249                     endm
                      (  test_macros.inc):00250         ;
                      (  test_macros.inc):00251         ; ---- every addressing mode --------------------------------------------------
                      (  test_macros.inc):00252         ;
                      (  test_macros.inc):00253         ; 8 bit accumulator instruction in immediate, direct, indexed and extended
                      (  test_macros.inc):00254         ; mode. \1 instruction, \2 register before, \3 operand, \4 result, \5 NZVC
                      (  test_macros.inc):00255         ; after (C is clear before the instruction).
0000                  (  test_macros.inc):00256         mode8a      macro
                      (  test_macros.inc):00257                     ldb #\3
                      (  test_macros.inc):00258                     stb VAR
                      (  test_macros.inc):00259                     stb <DPV
                      (  test_macros.inc):00260                     ldx #VAR
                      (  test_macros.inc):00261                     lda #\2
                      (  test_macros.inc):00262                     andcc #$F0
                      (  test_macros.inc):00263                     \1 #\3
                      (  test_macros.inc):00264                     chk_a \4
                      (  test_macros.inc):00265                     chk_ccm \5,$0F
                      (  test_macros.inc):00266                     lda #\2
                      (  test_macros.inc):00267                     andcc #$F0
                      (  test_macros.inc):00268                     \1 <DPV
                      (  test_macros.inc):00269                     chk_a \4
                      (  test_macros.inc):00270                     chk_ccm \5,$0F
                      (  test_macros.inc):00271                     lda #\2
                      (  test_macros.inc):00272                     andcc #$F0
                      (  test_macros.inc):00273                     \1 ,x
                      (  test_macros.inc):00274                     chk_a \4
                      (  test_macros.inc):00275                     chk_ccm \5,$0F
                      (  test_macros.inc):00276                     lda #\2
                      (  test_macros.inc):00277                     andcc #$F0
                      (  test_macros.inc):00278                     \1 >VAR
                      (  test_macros.inc):00279                     chk_a \4
                      (  test_macros.inc):00280                     chk_ccm \5,$0F
                      (  test_macros.inc):00281                     endm
0000                  (  test_macros.inc):00282         mode8b      macro
                      (  test_macros.inc):00283                     lda #\3
                      (  test_macros.inc):00284                     sta VAR
                      (  test_macros.inc):00285                     sta <DPV
                      (  test_macros.inc):00286                     ldx #VAR
                      (  test_macros.inc):00287                     ldb #\2
                      (  test_macros.inc):00288                     andcc #$F0
                      (  test_macros.inc):00289                     \1 #\3
                      (  test_macros.inc):00290                     chk_b \4
                      (  test_macros.inc):00291                     chk_ccm \5,$0F
                      (  test_macros.inc):00292                     ldb #\2
                      (  test_macros.inc):00293                     andcc #$F0
                      (  test_macros.inc):00294                     \1 <DPV
                      (  test_macros.inc):00295                     chk_b \4
                      (  test_macros.inc):00296                     chk_ccm \5,$0F
                      (  test_macros.inc):00297                     ldb #\2
                      (  test_macros.inc):00298                     andcc #$F0
                      (  test_macros.inc):00299                     \1 ,x
                      (  test_macros.inc):00300                     chk_b \4
                      (  test_macros.inc):00301                     chk_ccm \5,$0F
                      (  test_macros.inc):00302                     ldb #\2
                      (  test_macros.inc):00303                     andcc #$F0
                      (  test_macros.inc):00304                     \1 >VAR
                      (  test_macros.inc):00305                     chk_b \4
                      (  test_macros.inc):00306                     chk_ccm \5,$0F
                      (  test_macros.inc):00307                     endm
                      (  test_macros.inc):00308         ; Same for any 8 bit register: \1 load, \2 instruction, \3 compare,
                      (  test_macros.inc):00309         ; \4 before, \5 operand, \6 result, \7 NZVC after
0000                  (  test_macros.inc):00310         mode8r      macro
                      (  test_macros.inc):00311                     lda #\5
                      (  test_macros.inc):00312                     sta VAR
                      (  test_macros.inc):00313                     sta <DPV
                      (  test_macros.inc):00314                     ldx #VAR
                      (  test_macros.inc):00315                     \1 #\4
                      (  test_macros.inc):00316                     andcc #$F0
                      (  test_macros.inc):00317                     \2 #\5
                      (  test_macros.inc):00318                     pshs cc
                      (  test_macros.inc):00319                     \3 #\6
                      (  test_macros.inc):00320                     bne *
                      (  test_macros.inc):00321                     puls cc
                      (  test_macros.inc):00322                     chk_ccm \7,$0F
                      (  test_macros.inc):00323                     \1 #\4
                      (  test_macros.inc):00324                     andcc #$F0
                      (  test_macros.inc):00325                     \2 <DPV
                      (  test_macros.inc):00326                     pshs cc
                      (  test_macros.inc):00327                     \3 #\6
                      (  test_macros.inc):00328                     bne *
                      (  test_macros.inc):00329                     puls cc
                      (  test_macros.inc):00330                     chk_ccm \7,$0F
                      (  test_macros.inc):00331                     \1 #\4
                      (  test_macros.inc):00332                     andcc #$F0
                      (  test_macros.inc):00333                     \2 ,x
                      (  test_macros.inc):00334                     pshs cc
                      (  test_macros.inc):00335                     \3 #\6
                      (  test_macros.inc):00336                     bne *
                      (  test_macros.inc):00337                     puls cc
                      (  test_macros.inc):00338                     chk_ccm \7,$0F
                      (  test_macros.inc):00339                     \1 #\4
                      (  test_macros.inc):00340                     andcc #$F0
                      (  test_macros.inc):00341                     \2 >VAR
                      (  test_macros.inc):00342                     pshs cc
                      (  test_macros.inc):00343                     \3 #\6
                      (  test_macros.inc):00344                     bne *
                      (  test_macros.inc):00345                     puls cc
                      (  test_macros.inc):00346                     chk_ccm \7,$0F
                      (  test_macros.inc):00347                     endm
                      (  test_macros.inc):00348         ; 16 bit: \1 load, \2 instruction, \3 compare, \4 before, \5 operand,
                      (  test_macros.inc):00349         ; \6 result, \7 NZVC after. X is the pointer, so \1 must not be LDX.
0000                  (  test_macros.inc):00350         mode16      macro
                      (  test_macros.inc):00351                     ldx #\5
                      (  test_macros.inc):00352                     stx VAR16
                      (  test_macros.inc):00353                     stx <DPV16
                      (  test_macros.inc):00354                     \1 #\4
                      (  test_macros.inc):00355                     andcc #$F0
                      (  test_macros.inc):00356                     \2 #\5
                      (  test_macros.inc):00357                     pshs cc
                      (  test_macros.inc):00358                     \3 #\6
                      (  test_macros.inc):00359                     bne *
                      (  test_macros.inc):00360                     puls cc
                      (  test_macros.inc):00361                     chk_ccm \7,$0F
                      (  test_macros.inc):00362                     \1 #\4
                      (  test_macros.inc):00363                     andcc #$F0
                      (  test_macros.inc):00364                     \2 <DPV16
                      (  test_macros.inc):00365                     pshs cc
                      (  test_macros.inc):00366                     \3 #\6
                      (  test_macros.inc):00367                     bne *
                      (  test_macros.inc):00368                     puls cc
                      (  test_macros.inc):00369                     chk_ccm \7,$0F
                      (  test_macros.inc):00370                     \1 #\4
                      (  test_macros.inc):00371                     andcc #$F0
                      (  test_macros.inc):00372                     ldx #VAR16
                      (  test_macros.inc):00373                     \2 ,x
                      (  test_macros.inc):00374                     pshs cc
                      (  test_macros.inc):00375                     \3 #\6
                      (  test_macros.inc):00376                     bne *
                      (  test_macros.inc):00377                     puls cc
                      (  test_macros.inc):00378                     chk_ccm \7,$0F
                      (  test_macros.inc):00379                     \1 #\4
                      (  test_macros.inc):00380                     andcc #$F0
                      (  test_macros.inc):00381                     \2 >VAR16
                      (  test_macros.inc):00382                     pshs cc
                      (  test_macros.inc):00383                     \3 #\6
                      (  test_macros.inc):00384                     bne *
                      (  test_macros.inc):00385                     puls cc
                      (  test_macros.inc):00386                     chk_ccm \7,$0F
                      (  test_macros.inc):00387                     endm
                      (  test_macros.inc):00388         ; Read-modify-write on memory, direct, indexed and extended.
                      (  test_macros.inc):00389         ; \1 instruction, \2 value before, \3 value after, \4 NZVC after
                      (  test_macros.inc):00390         ; (C is set before, so ROL/ROR shift a 1 in)
0000                  (  test_macros.inc):00391         modemem     macro
                      (  test_macros.inc):00392                     ldx #VAR
                      (  test_macros.inc):00393                     lda #\2
                      (  test_macros.inc):00394                     sta <DPV
                      (  test_macros.inc):00395                     orcc #CC_C
                      (  test_macros.inc):00396                     \1 <DPV
                      (  test_macros.inc):00397                     chk_ccm \4,$0F
                      (  test_macros.inc):00398                     chk_mem DPV,\3
                      (  test_macros.inc):00399                     lda #\2
                      (  test_macros.inc):00400                     sta ,x
                      (  test_macros.inc):00401                     orcc #CC_C
                      (  test_macros.inc):00402                     \1 ,x
                      (  test_macros.inc):00403                     chk_ccm \4,$0F
                      (  test_macros.inc):00404                     chk_mem VAR,\3
                      (  test_macros.inc):00405                     lda #\2
                      (  test_macros.inc):00406                     sta VAR
                      (  test_macros.inc):00407                     orcc #CC_C
                      (  test_macros.inc):00408                     \1 >VAR
                      (  test_macros.inc):00409                     chk_ccm \4,$0F
                      (  test_macros.inc):00410                     chk_mem VAR,\3
                      (  test_macros.inc):00411                     endm
