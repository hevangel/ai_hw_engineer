     0110             (nctional_test.asm):00037         MASK        equ SCRATCH         ; 16 bit branch mask
     0112             (nctional_test.asm):00038         EXPECT      equ SCRATCH+2
     0114             (nctional_test.asm):00039         SAVE_S      equ SCRATCH+4
     0116             (nctional_test.asm):00040         SAVE_X      equ SCRATCH+6
     0118             (nctional_test.asm):00041         VAR         equ SCRATCH+8       ; extended mode operand
     011A             (nctional_test.asm):00042         VAR16       equ SCRATCH+10
     0130             (nctional_test.asm):00043         RES         equ SCRATCH+$20     ; results compared by chk_res ($20 bytes)
     0150             (nctional_test.asm):00044         SWI_VEC     equ SCRATCH+$40     ; RAM copies of the software interrupt vectors
     0152             (nctional_test.asm):00045         SWI2_VEC    equ SCRATCH+$42
     0154             (nctional_test.asm):00046         SWI3_VEC    equ SCRATCH+$44
     0156             (nctional_test.asm):00047         SWI_FLAG    equ SCRATCH+$46
     0158             (nctional_test.asm):00048         SWI_S       equ SCRATCH+$48
     0280             (nctional_test.asm):00049         DPV         equ $0280           ; direct page operand (DP = DP_PAGE)
     0282             (nctional_test.asm):00050         DPV16       equ $0282
     0300             (nctional_test.asm):00051         PATTERN     equ $0300           ; $0300-$05FF: byte at a = lo(a) EOR hi(a)
     0700             (nctional_test.asm):00052         PTRS        equ $0700           ; $0700-$073F: word k = $0300 + k*$11
