                      (nctional_test.asm):00140         ; ==========================================================================
                      (nctional_test.asm):00141         ; $02 - all 16 conditional branches, short form, for every N/Z/V/C value
                      (nctional_test.asm):00142         ; ==========================================================================
                      (nctional_test.asm):00143         ; MASK has bit n set if the branch must be taken when CC = n (CC bits
                      (nctional_test.asm):00144         ; 3..0 are N, Z, V, C).
10BE                  (nctional_test.asm):00145         brtest      macro
                      (nctional_test.asm):00146                     ldd #\2
                      (nctional_test.asm):00147                     std MASK
                      (nctional_test.asm):00148                     clrb
10BE                  (nctional_test.asm):00149         @loop       clra
                      (nctional_test.asm):00150                     lsr MASK
                      (nctional_test.asm):00151                     ror MASK+1
                      (nctional_test.asm):00152                     rola
                      (nctional_test.asm):00153                     sta EXPECT
                      (nctional_test.asm):00154                     tfr b,cc
