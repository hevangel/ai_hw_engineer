[tasks]
bmc
prove
cover
[options]
multiclock on
bmc: mode bmc
bmc: depth 32
prove: mode prove
prove: depth 32
cover: mode cover
cover: depth 64
[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3
[script]
read -formal -D FORMAL -I . mos_6526.sv mos_6526_timer.sv mos_6526_tod.sv mos_6526_serial.sv mos_6526_irq.sv
prep -top mos_6526
[files]
../src/mos_6526.sv
../src/mos_6526_timer.sv
../src/mos_6526_tod.sv
../src/mos_6526_serial.sv
../src/mos_6526_irq.sv
mos_6526_props.sv
mos_6526_timer_props.sv
mos_6526_tod_props.sv
mos_6526_serial_props.sv
mos_6526_irq_props.sv
