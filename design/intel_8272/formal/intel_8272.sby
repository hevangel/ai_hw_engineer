[tasks]
bmc
prove
cover_read
cover_write
cover_seek
cover_nd

[options]
bmc: mode bmc
bmc: depth 32
prove: mode prove
cover_read: mode cover
cover_read: depth 80
cover_write: mode cover
cover_write: depth 80
cover_seek: mode cover
cover_seek: depth 80
cover_nd: mode cover
cover_nd: depth 80

[engines]
bmc: abc bmc3
prove: abc pdr
cover_read: smtbmc z3
cover_write: smtbmc z3
cover_seek: smtbmc z3
cover_nd: smtbmc z3

[script]
bmc: read -formal -D FORMAL intel_8272.sv intel_8272_formal.sv
prove: read -formal -D FORMAL intel_8272.sv intel_8272_formal.sv
cover_read: read -formal -D FORMAL -D FORMAL_COVER -D COVER_READ -D FORMAL_SCENARIO=0 intel_8272.sv intel_8272_formal.sv
cover_write: read -formal -D FORMAL -D FORMAL_COVER -D COVER_WRITE -D FORMAL_SCENARIO=1 intel_8272.sv intel_8272_formal.sv
cover_seek: read -formal -D FORMAL -D FORMAL_COVER -D COVER_SEEK -D FORMAL_SCENARIO=2 intel_8272.sv intel_8272_formal.sv
cover_nd: read -formal -D FORMAL -D FORMAL_COVER -D COVER_ND -D FORMAL_SCENARIO=3 intel_8272.sv intel_8272_formal.sv
prep -top intel_8272_formal -flatten

[files]
../src/intel_8272.sv
intel_8272_props.sv
intel_8272_formal.sv
