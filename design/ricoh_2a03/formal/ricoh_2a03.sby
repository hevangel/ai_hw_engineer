[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 28

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -I . mos_6502_native.sv ricoh_2a03_length.sv ricoh_2a03_envelope.sv ricoh_2a03_pulse.sv ricoh_2a03_triangle.sv ricoh_2a03_noise.sv ricoh_2a03_dmc.sv ricoh_2a03_frame.sv ricoh_2a03_apu.sv ricoh_2a03_dma.sv ricoh_2a03.sv
prep -top ricoh_2a03 -flatten

