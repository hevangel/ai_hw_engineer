[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 32
prove: mode prove
cover: mode cover
cover: depth 110

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
bmc: read -formal -D FORMAL intel_8275.sv intel_8275_formal.sv
prove: read -formal -D FORMAL intel_8275.sv intel_8275_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER intel_8275.sv intel_8275_formal.sv
prep -top intel_8275_formal

[files]
../src/intel_8275.sv
intel_8275_props.sv
intel_8275_formal.sv
