[tasks]
pal_bmc pal bmc
pal_prove pal prove
pal_cover pal cover
ntsc_bmc ntsc bmc
ntsc_prove ntsc prove
ntsc_cover ntsc cover
[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
cover: mode cover
cover: depth 40
[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat yices
[script]
read -formal -D FORMAL -I . mos_6567.sv
pal: chparam -set VARIANT 0 mos_6567
ntsc: chparam -set VARIANT 1 mos_6567
prep -top mos_6567
# Variable-index reads are guarded; out-of-range bits read zero, not x.
chtype -map $shiftx $shift
setundef -anyseq
[files]
../src/mos_6567.sv
mos_6567_props.sv