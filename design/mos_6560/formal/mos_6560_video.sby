[tasks]
pal_bmc pal bmc
pal_prove pal prove
pal_cover pal cover
ntsc_bmc ntsc bmc
ntsc_prove ntsc prove
ntsc_cover ntsc cover
[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
cover: mode cover
cover: depth 40
[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat yices
[script]
read -formal -D FORMAL -I . mos_6560_video.sv
pal: chparam -set PAL 1 mos_6560_video
ntsc: chparam -set PAL 0 mos_6560_video
prep -top mos_6560_video
[files]
../src/mos_6560_video.sv
mos_6560_video_props.sv
