[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 32

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat --unroll z3

[script]
bmc: read -formal -D FORMAL ../src/intel_8251.sv
bmc: read -formal intel_8251_props.sv
prove: read -formal -D FORMAL ../src/intel_8251.sv
prove: read -formal intel_8251_props.sv
cover: read -formal -D FORMAL -D FORMAL_COVER ../src/intel_8251.sv
cover: read -formal intel_8251_cover.sv
prep -top intel_8251

[files]
../src/intel_8251.sv
intel_8251_props.sv
intel_8251_cover.sv
