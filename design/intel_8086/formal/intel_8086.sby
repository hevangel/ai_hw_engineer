[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
bmc: depth 24
prove: depth 12
cover: depth 48

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc yices

[script]
bmc: read -formal -sv intel_8086_alu.sv intel_8086.sv
prove: read -formal -sv intel_8086_alu.sv intel_8086.sv
cover: read -formal -sv intel_8086_alu.sv intel_8086.sv intel_8086_cover.sv
bmc: prep -top intel_8086
prove: prep -top intel_8086
cover: prep -top intel_8086_cover -flatten
cover: chformal -assert -remove
cover: opt_clean

[files]
../src/intel_8086_alu.sv
../src/intel_8086.sv
intel_8086_cover.sv
