[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 28
prove: mode prove
prove: depth 28
cover: mode cover
cover: depth 28

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
bmc: read -formal -D FORMAL ../src/intel_4003.sv
bmc: read -formal intel_4003_props.sv
prove: read -formal -D FORMAL ../src/intel_4003.sv
prove: read -formal intel_4003_props.sv
cover: read -formal -D FORMAL -D FORMAL_COVER ../src/intel_4003.sv
cover: read -formal intel_4003_cover.sv
prep -top intel_4003

[files]
../src/intel_4003.sv
intel_4003_props.sv
intel_4003_cover.sv
