Description: Remove only complete file-prefix-map flag words from the VPI helper
 The Debian 12.0-3 greedy sed expression can consume subsequent flags and
 leave a version suffix behind. GNU make filter-out preserves other words.
 This patch applies after Debian filter-out_iverilog-vpi_flags.patch.
--- a/Makefile.in
+++ b/Makefile.in
@@ -233,8 +233,8 @@
 	    -e 's;@SUFFIX@;$(suffix);' \
 	    -e 's;@IVCC@;$(CC);' \
 	    -e 's;@IVCXX@;$(CXX);' \
-	    -e 's;@IVCFLAGS@;$(shell echo $(CFLAGS) | sed -e 's/-ffile-prefix-map=.*\.//');' \
-	    -e 's;@IVCXXFLAGS@;$(shell echo $(CXXFLAGS) | sed -e 's/-ffile-prefix-map=.*\.//');' \
+	    -e 's;@IVCFLAGS@;$(filter-out -ffile-prefix-map=%,$(CFLAGS));' \
+	    -e 's;@IVCXXFLAGS@;$(filter-out -ffile-prefix-map=%,$(CXXFLAGS));' \
 	    -e 's;@IVCTARGETFLAGS@;$(CTARGETFLAGS);' \
 	    -e 's;@INCLUDEDIR@;$(includedir);' \
 	    -e 's;@LIBDIR@;@libdir@;' $< > $@
